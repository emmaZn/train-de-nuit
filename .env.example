# Le vrai projet Firebase. À copier en `.env.local` (que `.gitignore` tient
# déjà à l'écart par sa règle `*.local`) et à remplir le jour où l'émulateur ne
# suffit plus. Voir « Passer au vrai projet » dans le README.
#
# Tant que VITE_FIREBASE_PROJECT_ID est vide, le site parle à l'émulateur local
# sous le projet `demo-train-de-nuit` ; dès qu'elle porte un vrai identifiant,
# `npm run dev` lui-même parle à la production. Le script de semis et les tests
# de règles, eux, nomment `demo-train-de-nuit` en dur : ces variables ne les
# redirigent pas, et le préfixe `demo-` leur rend la production inatteignable
# par construction.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# La clé de site reCAPTCHA v3 d'App Check. Sans elle, App Check reste dormant.
# Avec elle, il s'initialise — mais il ne protège rien tant que l'application
# des règles n'est pas armée pour Firestore dans la console. Le README le dit.
VITE_RECAPTCHA_KEY=
