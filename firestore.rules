rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /traces/{id} {
      // Reading one document: only an approved one, whoever asks.
      allow get: if resource.data.approuvee == true;

      // Listing: the sky's one query, and nothing wider. The approval clause
      // still has to be provable from the query itself; the bound is what the
      // design doc promises — « le site ne télécharge jamais plus de N
      // phrases ». 120 is the desktop limit, 50 the phone one (scene/stars.ts),
      // so both pass and an unbounded read does not.
      allow list: if resource.data.approuvee == true
                  && request.query.limit <= 120;

      // Length is checked with matches(), not size(): size() counts UTF-16 code
      // units (an emoji weighs 2), while the form counts code points. RE2's `.`
      // matches one code point, so 80 code points always pass and 81 never do.
      allow create: if request.resource.data.keys().hasOnly(['phrase', 'prenom', 'creeLe', 'approuvee', 'x', 'y'])
                    && request.resource.data.keys().hasAll(['phrase', 'creeLe', 'approuvee', 'x', 'y'])
                    && request.resource.data.phrase is string
                    && request.resource.data.phrase.trim().size() > 0
                    && request.resource.data.phrase.matches('(?s).{1,80}')
                    && (!('prenom' in request.resource.data)
                        || (request.resource.data.prenom is string
                            && request.resource.data.prenom.matches('(?s).{0,24}')))
                    && request.resource.data.creeLe == request.time
                    && request.resource.data.approuvee == false
                    && request.resource.data.x is number
                    && request.resource.data.x >= 0 && request.resource.data.x <= 1
                    && request.resource.data.y is number
                    && request.resource.data.y >= 0 && request.resource.data.y <= 1;

      allow update, delete: if false;
    }
  }
}
